{
    "configurations": [
        {
            "name": "Host (GoogleTest)",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:HOME}/.local/include",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "RISC-V Cross (RVV)",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/riscv/riscv64-unknown-linux-gnu/include",
                "/opt/riscv/lib/gcc/riscv64-unknown-linux-gnu/15.2.0/include",
                "/opt/riscv/riscv64-unknown-linux-gnu/include/c++/15.2.0"
            ],
            "defines": [
                "__riscv",
                "__riscv_v",
                "__riscv_xlen=64"
            ],
            "compilerPath": "/opt/riscv/bin/riscv64-unknown-linux-gnu-g++",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}